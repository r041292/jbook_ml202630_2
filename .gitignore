# Publicar los archivos de ejecución del dashboard y el informe Jupyter Book.
/*
!/.gitignore
!/.gitattributes
!/.python-version
!/render.yaml
!/Dash/
!/Precalculo/
!/jbook_dashboard/
!/.github/

/Dash/*
