# Publicar exclusivamente los archivos necesarios para ejecutar el dashboard.
/*
!/.gitignore
!/.gitattributes
!/.python-version
!/render.yaml
!/Dash/
!/Precalculo/

/Dash/*
!/Dash/app.py
!/Dash/charts.py
!/Dash/prediction.py
!/Dash/prepare_data.py
!/Dash/deployment.py
!/Dash/requirements.txt
!/Dash/img.jpeg
!/Dash/assets/
!/Dash/data/

/Dash/assets/*
!/Dash/assets/style.css
/Dash/data/*
!/Dash/data/train.csv.gz
!/Dash/data/test.csv.gz
!/Dash/data/augmentation.csv.gz
!/Dash/data/fold_metrics.csv
!/Dash/data/coefficients.csv
!/Dash/data/comparison_details.json
!/Dash/data/model.joblib
!/Dash/data/manifest.json
!/Dash/data/deployment.json

/Precalculo/*
!/Precalculo/00_seleccion_base_datos.md
!/Precalculo/comparacion_aumentacion/
!/Precalculo/resultados/
/Precalculo/comparacion_aumentacion/*
!/Precalculo/comparacion_aumentacion/comparacion_train.csv
!/Precalculo/comparacion_aumentacion/seleccion.json
/Precalculo/resultados/*
!/Precalculo/resultados/eda.json
!/Precalculo/resultados/modelos_lineales.json

# Documentación interna, instrucciones, pruebas y archivos locales.
**/AGENTS.md
**/CONTEXT.md
**/README.md
**/.agents/
**/.codex/
**/__pycache__/
*.pyc
**/venv/
**/.env
**/.env.*
**/test_*.py
**/preview*.jpg
**/prepare_deployment.py
**/prepare_comparison.py
